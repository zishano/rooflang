        <mxCell id="link-label" value="InfiniBand" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=17;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1400" y="565" width="175" height="40" />
        </mxCell>
        <mxCell id="external" value="代码中的网络交换机&lt;br&gt;不代表另一个已建模节点" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=19;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1480" y="740" width="385" height="90" />
        </mxCell>
        <mxCell id="note" value="八张 GPU 已合并为一个计算节点，因此不再显式表示 NVSwitch；两颗 CPU 已聚合，因此没有 CPU 间 QPI。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=21;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="40" y="945" width="1820" height="60" />
        </mxCell>
        <mxCell id="spec" value="聚合资源规格（全部来自代码）&lt;br&gt;GPU：FP4 / FP8 15832 TFLOPS；&lt;br&gt;BF16 / FP16 7916 TFLOPS；FP32 3956 TFLOPS。&lt;br&gt;CPU：BF16 / FP16 510.58 TFLOPS；INT8 1022.36 TOPS。&lt;br&gt;HBM：1152 GB；DDR5：3072 GB；SSD：2048000 GB。&lt;br&gt;内部 GPU 差异、NVSwitch 竞争及 CPU NUMA 差异被隐藏。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=20;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="40" y="1050" width="865" height="280" />
        </mxCell>
        <mxCell id="links-note" value="统一链路参数（带宽 GB/s；α 为 μs）&lt;br&gt;GPU ↔ HBM：38400 / 方向；α 0.5；非全双工。&lt;br&gt;4 条普通 PCIe：512 / 方向；α 0.5；全双工。&lt;br&gt;NIC ↔ IB Switch：400 / 方向；α 1；全双工。&lt;br&gt;CPU ↔ DDR5：665.6 / 方向；α 0.1；非全双工。&lt;br&gt;SSD → HGX Switch：112；反向：56；α 50；全双工。&lt;br&gt;普通 PCIe：GPU–HGX、NIC–HGX、CPU Switch–HGX、CPU–CPU Switch。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=20;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="950" y="1050" width="910" height="300" />
        </mxCell>
        <mxCell id="footer" value="图中连线表示可双向传输。非全双工链路的双向流量共享资源；聚合模型不意味着所有资源在实机上可无损合并。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontSize=18;fontFamily=Noto Sans CJK SC;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="40" y="1360" width="1820" height="60" />
        </mxCell>
