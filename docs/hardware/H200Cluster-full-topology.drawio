        <mxCell id="legend" value="&lt;b&gt;统一参数说明（GB/s；α 为 μs）&lt;/b&gt;&lt;br&gt;GPU–HBM：4800，α 0.5，非全双工；GPU–NVSwitch：450，α 0.5，全双工。&lt;br&gt;GPU/NIC/CPU–PCIe Switch：64，α 0.5，全双工；NIC–IB Switch：50，α 1，全双工。&lt;br&gt;SSD→Switch：14，反向 7，α 50，全双工；CPU–DDR5：332.8，α 0.1，非全双工；CPU–CPU：192，α 0.05，全双工。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=20;spacing=8;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=top;">
          <mxGeometry as="geometry" x="40" y="1310" width="2300" height="155" />
        </mxCell>
        <mxCell id="specs" value="&lt;b&gt;设备规格（来自代码预设）&lt;/b&gt;&lt;br&gt;每 GPU：H200 SXM；FP4/FP8 1979、BF16/FP16 989.5、FP32 494.5 TFLOPS。每 CPU：Xeon 6767P；BF16/FP16 255.29、INT8 511.18。&lt;br&gt;每 HBM 144 GB；每 DDR5 1536 GB；每 SSD 256000 GB；每 NIC 为 ConnectX-7（400 Gb/s）。默认 n_nodes=1 时只有一个节点。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=20;spacing=8;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=top;">
