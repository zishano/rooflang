        <mxCell id="mapping" value="CPU 0 实际连接本节点 PCIe Switch 0–3；CPU 1 实际连接 4–7。图中仅显示到第 0、7 路的连接，其余随设备一同省略。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;fontSize=20;spacing=8;strokeColor=none;fillColor=none;fontSize=18;align=left;verticalAlign=top;">
