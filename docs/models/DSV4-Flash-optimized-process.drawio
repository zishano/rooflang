        <mxCell id="validate" value="检查参数 / 设置专家权重读取比例&lt;br&gt;建立 layer_stages、stage_gpus" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontSize=23;spacing=10;">
