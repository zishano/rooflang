          <mxGeometry as="geometry" x="650" y="445" width="570" height="40" />
        </mxCell>
        <mxCell id="note-body1" value="两份 Attention 各读取半份上下文 KV。&lt;br&gt;Q 路径复制；后续普通算子按 batch 切分。&lt;br&gt;Attention 输出可形成 ReduceScatter。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
