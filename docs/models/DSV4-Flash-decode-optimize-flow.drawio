        <mxCell id="note-title2" value="EP 与 PP 在哪里体现？" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=22;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1260" y="445" width="570" height="40" />
        </mxCell>
        <mxCell id="note-body2" value="EP=8：后续 Placement 将专家分给 8 卡。&lt;br&gt;PP=[43]：一个阶段包含全部 43 层；&lt;br&gt;不是 43 个阶段，也不再乘出 8 倍 GPU。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1260" y="492" width="570" height="110" />
        </mxCell>
        <mxCell id="foot" value="这是对同一个 g 的原地变换。“优化后 g”是概念上的中间状态；函数完成 Placement 后才返回 (g, p)。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
