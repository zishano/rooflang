        <mxCell id="note-title0" value="算子 → GPU" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=22;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="40" y="445" width="570" height="40" />
        </mxCell>
        <mxCell id="note-body0" value="每个 DP 组的代表 GPU 是 dp_rank × 2。&lt;br&gt;Embedding、输出头和 DP-only 算子在代表卡；&lt;br&gt;Q / Attention 等副本分布在全部 8 张卡。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="40" y="492" width="570" height="110" />
        </mxCell>
        <mxCell id="note-panel1" value="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=21;spacing=10;">
          <mxGeometry as="geometry" x="640" y="435" width="590" height="170" />
        </mxCell>
        <mxCell id="note-title1" value="张量 → 内存" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=22;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="650" y="445" width="570" height="40" />
        </mxCell>
        <mxCell id="note-body1" value="token 输入来源为 DRAM，历史 KV 来源为 SSD。&lt;br&gt;预加载后，KV 分片位于各卡本地 HBM；&lt;br&gt;通信端点位置决定需要走哪些硬件链路。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="650" y="492" width="570" height="110" />
        </mxCell>
        <mxCell id="note-panel2" value="" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=21;spacing=10;">
          <mxGeometry as="geometry" x="1250" y="435" width="590" height="170" />
        </mxCell>
        <mxCell id="note-title2" value="此时还没有执行模型" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=22;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1260" y="445" width="570" height="40" />
        </mxCell>
        <mxCell id="note-body2" value="Placement 保存设备和内存映射。&lt;br&gt;Simulator 随后结合 g、p、hw 模拟计算与传输；&lt;br&gt;箭头顺序不是各 GPU 的实际运行时间线。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="1260" y="492" width="570" height="110" />
        </mxCell>
        <mxCell id="foot" value="三张图串起来：declare_model → 原始 g → 并行变换后的 g → Placement → (g, p, hw) → Simulator。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=19;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="30" y="625" width="1800" height="45" />
        </mxCell>
