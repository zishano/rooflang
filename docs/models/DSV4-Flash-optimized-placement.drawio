        <mxCell id="edge-1" edge="1" parent="1" source="ssd" target="hbm" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;strokeColor=#475569;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;">
