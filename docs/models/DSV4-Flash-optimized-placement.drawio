        <mxCell id="edge-2" edge="1" parent="1" source="hbm" target="barrier" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;rounded=0;strokeColor=#475569;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.5;dashed=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="memnote" value="token 输入：DDR5 0 → GPU0 上的 read_input → 四个 DP Embedding（GPU0/2/4/6）。&lt;br&gt;set_kernel_device 会为相关张量分配默认本地内存；set_tensor_memory 设置 SSD、DRAM、路由等特殊位置。&lt;br&gt;通信 Kernel 通常无需绑定单个 GPU；根据张量端点与硬件拓扑使用链路。本例单节点，跨 GPU 通信走节点内互联。&lt;br&gt;图中 r=0…7；GPU r 对应 SSD r。EP=8 和 DP×CP=8 复用这 8 张卡，不相乘为 64 张卡。" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=22;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
          <mxGeometry as="geometry" x="35" y="1490" width="2420" height="215" />
        </mxCell>
