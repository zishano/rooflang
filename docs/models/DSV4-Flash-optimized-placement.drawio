        </mxCell>
        <mxCell id="barrier" value="barrier 的 KV 输入&lt;br&gt;仍指向对应层 / rank 的本地 HBM&lt;br&gt;保持 cache 存活到输出完成" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=21;spacing=10;">
