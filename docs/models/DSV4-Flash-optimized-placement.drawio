        </mxCell>
        <mxCell id="hbm" value="HBM r&lt;br&gt;预加载后的 KV、该 GPU 算子数据&lt;br&gt;显式位置可以覆盖默认分配" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontSize=21;spacing=10;">
