        <mxCell id="memtitle" value="内存放置与通信" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=white;strokeColor=white;fontSize=26;spacing=10;align=left;verticalAlign=top;strokeColor=none;">
