# Copy outside the repository, fill in credentials, and pass with --env-file.
# Never commit a populated environment file.

ROOFLANG_CODEX_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
ROOFLANG_SUBAGENT_MODEL=deepseek-flash

# Optional proxy configuration. Host shell settings are not inherited.
# HTTPS_PROXY=
# HTTP_PROXY=
# NO_PROXY=
